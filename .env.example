# 核心协议注册
PROTOCOL_PAGE_URL=
PROTOCOL_TURNSTILE_ACTION=
PROTOCOL_TOS_ACCEPTED_VERSION=1
# 前端公钥（可被 x.ai 轮换）：留空则使用代码内置默认值
PROTOCOL_TURNSTILE_SITEKEY=
PROTOCOL_CASTLE_PUBLISHABLE_KEY=

# MOEMAIL 邮箱服务
MOEMAIL_API_BASE=
MOEMAIL_API_KEY=
MOEMAIL_DOMAIN=
MOEMAIL_EXPIRY_TIME=86400000
MOEMAIL_USE_PROXY=false

# 人机验证（CapSolver）
CAPSOLVER_API_KEY=
CAPSOLVER_TIMEOUT_SEC=120
CAPSOLVER_POLL_INTERVAL_SEC=1.0

# Castle 反滥用令牌服务
CASTLE_PROVIDER_URL=
CASTLE_PROVIDER_KEY=
CASTLE_EMAIL_TOKEN=
CASTLE_FINAL_TOKEN=

# 本地无头浏览器 Sidecar（true: 替代 CapSolver 与 Node JSDOM；false: 保持原生）
USE_LOCAL_SIDECAR=false
SIDECAR_HEADLESS=true
SIDECAR_POOL_SIZE=2
SIDECAR_MAX_AGE_SEC=240
SIDECAR_BROWSER_CHANNEL=
SIDECAR_LOCALE=en-US
SIDECAR_TIMEZONE=America/New_York
SIDECAR_TURNSTILE_TIMEOUT=30
SIDECAR_CASTLE_TIMEOUT=20

# 网络、代理和请求指纹
PROXY=
PROXY_ENABLED=false
# 指纹：FINGERPRINT_MODE=random|fixed；可指定 ACCEPT_LANGUAGE / FINGERPRINT_REGION 与代理出口对齐
FINGERPRINT_MODE=random
ACCEPT_LANGUAGE=
FINGERPRINT_REGION=

# 状态机步骤级重试（吸收收信延迟与 RPC 抖动）
STEP_ATTEMPTS=3
STEP_BACKOFF=1.5
MAX_STEP_BACKOFF=8.0

# 注册运行参数
DEFAULT_DOMAINS=
